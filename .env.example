# 🔒 Configurazione di sicurezza per AgentiOLLAMAMatrix
# Copia questo file in .env e modifica i valori

# Chiavi API (separate da virgola)
API_KEYS=demo_key_123,admin_key_456,test_key_789

# Origini CORS consentite (separate da virgola)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:54324

# Segreto per sessioni Flask
SECRET_KEY=genera-un-segreto-sicuro-con-secrets.token_hex(32)

# Livello di logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Forza HTTPS (true/false)
FORCE_HTTPS=true

# Configurazione Ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:14b-instruct-q4_K_M

# Configurazione Flask
FLASK_ENV=development
FLASK_DEBUG=false

# Configurazione Cache
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# Configurazione Rate Limiting
RATE_LIMIT_DEFAULT=200 per day; 50 per hour; 10 per minute

# 📝 Istruzioni:
# 1. Copia questo file in .env
# 2. Modifica le chiavi API per la produzione
# 3. Genera un SECRET_KEY sicuro con: python -c "import secrets; print(secrets.token_hex(32))"
# 4. In produzione, imposta FORCE_HTTPS=true e FLASK_DEBUG=false
# 5. Non committare il file .env nel repository